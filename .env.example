# Copy this file to .env and fill in your own keys.
# .env is git-ignored and docker-ignored, so your keys never leave your machine.

# Google Gemini (required): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_key
GOOGLE_MODEL=gemini-3.5-flash-lite

# Tavily web search (required for the web search tool): https://app.tavily.com
TAVILY_API_KEY=your_tavily_key

# LangSmith tracing (optional): https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=salibot

# Online PostgreSQL database (optional). Leave it out to use local files in data/.
# On a host like Render, set it so accounts and chats survive restarts.
# Free option: https://neon.tech (copy the connection string)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
